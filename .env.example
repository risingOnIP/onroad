# Base URL of the OnroadAI API (onroad-express), including the /api prefix
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:3200/api

# Supabase project used for authentication and storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Comma-separated list of addresses that receive contact form submissions
CONTACT_EMAIL_RECIPIENTS=admin@example.com
